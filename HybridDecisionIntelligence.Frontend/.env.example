# Environment Configuration Template

# API Configuration
# Replace with your backend API URL
# Development: https://localhost:7074 (local)
# Production: https://api.yourdomain.com (deployed)
REACT_APP_API_URL=https://localhost:7074/api

# API Timeout (milliseconds)
REACT_APP_TIMEOUT=10000

# Feature Flags (Optional)
REACT_APP_ENABLE_POLLING=false
REACT_APP_POLLING_INTERVAL=10000

# Analytics (Optional)
# REACT_APP_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Sentry Error Tracking (Optional)
# REACT_APP_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
